// Trendz Mobile — multi-vendor refurbished-tech marketplace.
// All money is stored as whole Pakistani rupees (PKR) in Int columns.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (tables used by Better Auth) ──────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

model User {
  id                  String    @id
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean?
  role                UserRole  @default(BUYER)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]
  addresses           Address[]
  seller              Seller?
  cart                Cart?
  orders              Order[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Buyers ─────────────────────────────────────────────────────────────────

enum Province {
  PUNJAB
  SINDH
  KHYBER_PAKHTUNKHWA
  BALOCHISTAN
  ISLAMABAD
  GILGIT_BALTISTAN
  AZAD_KASHMIR
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  province   Province
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─── Sellers ────────────────────────────────────────────────────────────────

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

model Seller {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName      String
  slug          String        @unique
  description   String?
  phone         String
  city          String
  cnic          String
  ntn           String?
  bankName      String?
  accountTitle  String?
  iban          String?
  status        SellerStatus  @default(PENDING)
  /// Platform commission in basis points (1000 = 10%).
  commissionBps Int           @default(1000)
  ratingAvg     Float?
  ratingCount   Int           @default(0)
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  offers        Offer[]
  sellerOrders  SellerOrder[]
  payouts       Payout[]

  @@index([status])
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  /// Shown in the header nav and the home "Most wanted" carousel.
  isFeatured  Boolean    @default(false)
  products    Product[]

  @@index([parentId])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id])
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  specs       Json            @default("{}")
  images      String[]
  /// Retail price of this model when new, for "Save X vs new".
  newPrice    Int?
  releaseYear Int?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  options     ProductOption[]
  variants    Variant[]
  offers      Offer[]

  @@index([categoryId])
  @@index([brandId])
}

enum OptionType {
  CONDITION
  BATTERY
  STORAGE
  RAM
  PROCESSOR
  SIM
  COLOR
  OTHER
}

/// One picker on the product page (Condition, Storage, Color…).
model ProductOption {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      OptionType
  name      String
  position  Int           @default(0)
  values    OptionValue[]

  @@unique([productId, name])
}

model OptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  label    String
  value    String
  /// Swatch color for COLOR options.
  colorHex String?
  position Int           @default(0)
  variants Variant[]

  @@unique([optionId, value])
}

/// One exact combination of option values, e.g. Good · 128 GB · Blue.
model Variant {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String        @unique
  /// Sorted OptionValue ids joined by "|", so a combination exists only once.
  combinationKey String
  optionValues   OptionValue[]
  offers         Offer[]

  @@unique([productId, combinationKey])
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
}

/// A seller's listing for one variant. This is what buyers actually purchase.
model Offer {
  id             String      @id @default(cuid())
  sellerId       String
  seller         Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// Copied from the variant so listings can group offers by product in one query.
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price          Int
  stock          Int         @default(0)
  warrantyMonths Int         @default(12)
  status         OfferStatus @default(ACTIVE)
  sellerSku      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@unique([sellerId, variantId])
  @@index([variantId, status, price])
  @@index([productId, status, price])
}

// ─── Cart ───────────────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set for signed-out shoppers; merged into the user's cart on sign-in.
  guestToken String?    @unique
  items      CartItem[]
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id       String @id @default(cuid())
  cartId   String
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offerId  String
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  quantity Int    @default(1)

  @@unique([cartId, offerId])
}

// ─── Orders ─────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  /// Everything was delivered, then returned and refunded.
  RETURNED
}

enum PaymentMethod {
  COD
  CARD
  JAZZCASH
  EASYPAISA
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model Order {
  id            String        @id @default(cuid())
  /// Human-friendly order number shown to customers.
  number        Int           @unique @default(autoincrement())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  /// Online payments only: unpaid orders are cancelled (and restocked) after this.
  paymentDueAt  DateTime?
  subtotal      Int
  shippingFee   Int           @default(0)
  total         Int
  shipName      String
  shipPhone     String
  shipLine1     String
  shipLine2     String?
  shipCity      String
  shipProvince  Province
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sellerOrders  SellerOrder[]
  payments      Payment[]

  @@index([userId])
}

enum FulfillmentStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

/// The part of an order fulfilled by one seller.
model SellerOrder {
  id             String            @id @default(cuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         Seller            @relation(fields: [sellerId], references: [id])
  status         FulfillmentStatus @default(PENDING)
  subtotal       Int
  /// Delivery fee charged to the buyer for this seller's shipment.
  shippingFee    Int               @default(0)
  commission     Int
  courier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  payoutId       String?
  payout         Payout?           @relation(fields: [payoutId], references: [id])
  items          OrderItem[]

  @@index([sellerId, status])
  @@index([orderId])
}

model OrderItem {
  id             String          @id @default(cuid())
  sellerOrderId  String
  sellerOrder    SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  offerId        String
  offer          Offer           @relation(fields: [offerId], references: [id])
  /// Snapshots so the order stays readable if the catalog changes.
  productName    String
  variantLabel   String
  unitPrice      Int
  quantity       Int
  returnRequests ReturnRequest[]
}

/// One payment attempt. Online orders can have several (a failed try, then a retry).
model Payment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  /// "safepay" or "test"; null for cash on delivery.
  provider       String?
  /// The gateway's id for this attempt (Safepay tracker token).
  providerRef    String?
  amount         Int
  status         PaymentStatus @default(UNPAID)
  refundedAmount Int           @default(0)
  /// Last gateway response or webhook, for support and audits.
  raw            Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([orderId])
  @@index([provider, providerRef])
}

enum PayoutStatus {
  PENDING
  PAID
}

model Payout {
  id           String        @id @default(cuid())
  sellerId     String
  seller       Seller        @relation(fields: [sellerId], references: [id])
  amount       Int
  status       PayoutStatus  @default(PENDING)
  reference    String?
  periodStart  DateTime
  periodEnd    DateTime
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  sellerOrders SellerOrder[]

  @@index([sellerId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

/// A buyer returning one order line (all of its units).
model ReturnRequest {
  id           String       @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  reason       String
  details      String?
  status       ReturnStatus @default(REQUESTED)
  /// Note from Trendz to the buyer (rejection reason, return instructions…).
  resolution   String?
  refundAmount Int?
  /// Bank / wallet transfer reference for the refund.
  refundRef    String?
  refundedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderItemId])
  @@index([status])
}

// ─── Merchandising ──────────────────────────────────────────────────────────

enum BannerPlacement {
  HOME_HERO
  HOME_PROMO
}

model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  title     String
  subtitle  String?
  ctaLabel  String?
  /// Urdu text for the /ur storefront; the English fields are used when these are empty.
  titleUr    String?
  subtitleUr String?
  ctaLabelUr String?
  ctaHref   String?
  image     String?
  /// Color theme key used by the UI, e.g. "mint" or "mango".
  theme     String          @default("mint")
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
}
