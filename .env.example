# Copy to .env and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/trendz_mobile?schema=public"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments: "test" = built-in local test gateway (development only); "safepay" = Safepay.
PAYMENT_PROVIDER="test"
# Any random string; signs test-gateway webhooks. openssl rand -hex 32
TEST_GATEWAY_SECRET=""
# Safepay dashboard → Developers. Use "sandbox" until you go live, then "production".
SAFEPAY_ENV="sandbox"
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
# Safepay dashboard → Developers → Endpoints → View shared secret
SAFEPAY_WEBHOOK_SECRET=""
# Protects /api/cron/* endpoints. openssl rand -hex 32
CRON_SECRET=""

# ERP stock (shared database). The ERP's `online_stock` view is read with a SELECT-only role.
# In production this is the same Supabase Postgres as DATABASE_URL, connecting as the read-only role.
ERP_STOCK_DATABASE_URL=""
ERP_STOCK_VIEW="covison_app.online_stock"
# Warranty promised on online listings (counter purchases don't record one; Trendz requires at least 365).
ERP_ONLINE_WARRANTY_DAYS="365"
