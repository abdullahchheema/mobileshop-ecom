# Copy to .env.local and fill in. This storefront has no database: everything comes from the ERP.

# The ERP's public catalogue views (Supabase, schema "api"). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Optional: runtime overrides (read when the server starts, no rebuild needed). NEXT_PUBLIC_* above are baked in at build time.
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# The ERP's order API. SERVER ONLY: never prefix with NEXT_PUBLIC_, never commit. The ERP calls its copy ONLINE_API_KEY.
ERP_API_URL="https://your-erp.vercel.app"
ERP_API_KEY=""

# Public address of this storefront (used for sitemap and absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
