# Copy to .env and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/trendz_mobile?schema=public"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments: "test" = built-in local test gateway (development only); "safepay" = Safepay.
PAYMENT_PROVIDER="test"
# Any random string; signs test-gateway webhooks. openssl rand -hex 32
TEST_GATEWAY_SECRET=""
# Safepay dashboard → Developers. Use "sandbox" until you go live, then "production".
SAFEPAY_ENV="sandbox"
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
# Safepay dashboard → Developers → Endpoints → View shared secret
SAFEPAY_WEBHOOK_SECRET=""
# Protects /api/cron/* endpoints. openssl rand -hex 32
CRON_SECRET=""
